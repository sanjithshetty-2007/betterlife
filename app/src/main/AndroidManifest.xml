<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminder permissions (context.md section 10). INTERNET arrives in Prompt S1;
         microphone, camera and biometrics in later prompts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sideloaded app, so USE_EXACT_ALARM is allowed. Still verified at runtime with canScheduleExactAlarms(). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BetterLifeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterLife">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pop-up on the lock screen (Path B). Own empty task affinity so it never pulls the main app
             over the lock screen, and it does not linger in recents. -->
        <activity
            android:name=".reminders.fullscreen.FullScreenReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterLife.Popup"
            android:turnScreenOn="true" />

        <!-- Owns the pop-up while it shows. systemExempted is allowed because the app holds USE_EXACT_ALARM,
             and has no time limit (shortService stops after ~3 minutes). -->
        <service
            android:name=".reminders.popup.ReminderPopupService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Exact alarm target. Not exported: only our own PendingIntent can reach it. -->
        <receiver
            android:name=".reminders.alarm.TestAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms alarms after reboot and app updates. These broadcasts are protected (only the system
             can send them), so exporting the receiver does not let other apps trigger it. -->
        <receiver
            android:name=".reminders.alarm.RearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
