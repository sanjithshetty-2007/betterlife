<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminder permissions (context.md section 10). INTERNET arrives in Prompt S1;
         microphone, camera and biometrics in later prompts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sideloaded app, so USE_EXACT_ALARM is allowed. Still verified at runtime with canScheduleExactAlarms(). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Prompt S1: only for Supabase sign-in and sync (sync/ package) and later link previews.
         Reminders never use the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BetterLifeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterLife">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pop-up on the lock screen (Path B). Own empty task affinity so it never pulls the main app
             over the lock screen, and it does not linger in recents. -->
        <activity
            android:name=".reminders.fullscreen.FullScreenReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterLife.Popup"
            android:turnScreenOn="true" />

        <!-- Owns the pop-up while it shows. systemExempted is allowed because the app holds USE_EXACT_ALARM,
             and has no time limit (shortService stops after ~3 minutes). -->
        <service
            android:name=".reminders.popup.ReminderPopupService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Exact alarm target. Not exported: only our own PendingIntent can reach it. -->
        <receiver
            android:name=".reminders.alarm.TestAlarmReceiver"
            android:exported="false" />

        <!-- Reminder engine alarm target. Not exported: only our own PendingIntent can reach it. -->
        <receiver
            android:name=".reminders.engine.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Morning check-in and evening wrap-up nudges. Not exported: only our own alarm reaches it. -->
        <receiver
            android:name=".reminders.daily.DailyPromptReceiver"
            android:exported="false" />

        <!-- The daily tracker reminders, protein and sleep (owner's features). Not exported: only our own alarms reach it. -->
        <receiver
            android:name=".reminders.tracker.TrackerReminderReceiver"
            android:exported="false" />

        <!-- Silent reminders: vibration only (owner's feature). Not exported: only our own alarm reaches it. -->
        <receiver
            android:name=".reminders.silent.SilentReminderReceiver"
            android:exported="false" />

        <!-- The habit widget (Prompt 19). Exported because the launcher sends it the widget broadcasts. -->
        <receiver
            android:name=".widgets.HabitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!-- The task and calendar widgets (Prompt 20). -->
        <receiver
            android:name=".widgets.TaskWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.CalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- The task widget's + opens this small popup over the home screen (widgets cannot show a keyboard).
             Its own task, so it never brings the rest of the app forward. -->
        <activity
            android:name=".widgets.QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterLife.Dialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Asks month grid or next events when a calendar widget is added. The launcher starts it, so it is exported. -->
        <activity
            android:name=".widgets.CalendarWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterLife.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Re-arms alarms after reboot, app updates, clock and time-zone changes. These broadcasts are
             protected (only the system can send them), so exporting the receiver does not let other apps
             trigger it. All four are allowed for manifest receivers on Android 8+. -->
        <receiver
            android:name=".reminders.alarm.RearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
